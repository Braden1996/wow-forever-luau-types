-- Values (not functions) the client's Lua 5.1 has. Its resource lists name only functions, so without these
-- the settings would disable `_G` or `math.pi`.
local clientValues: { [string]: boolean } = { _G = true, _VERSION = true, ["math.huge"] = true, ["math.pi"] = true }

-- Library functions Luau provides with a different contract from WoW's: the definitions keep Luau's, so the
-- WoW form is excluded with this explanation.
local luauConflicts: { [string]: string } = {
	["string.split"] = "Luau's string.split(s, separator) returns a table; WoW's string.split(delimiter, s) "
		.. "returns the pieces, and a definitions file cannot override Luau's. Use strsplit",
}

-- Local names upstream's compat.lua uses for the standard tables (`local tab = table`), mapped to the table.
local stdlibAliases: { [string]: string } =
	{ tab = "table", str = "string", math = "math", string = "string", table = "table" }

return {
	luauGlobals = luauGlobals,
	luauStdlib = luauStdlib,
	luauLibraryMembers = luauLibraryMembers,
	clientValues = clientValues,
	luauConflicts = luauConflicts,
	stdlibAliases = stdlibAliases,
}
