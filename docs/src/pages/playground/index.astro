---
import { Aside } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import { Playground } from "../../components/playground/playground.tsx";
import { withBase } from "../../lib/site.ts";
---

<StarlightPage
  frontmatter={{
    title: "Playground",
    description: "Type-check Luau against the WoW: Forever definitions in your browser: Luau's analyser compiled to WebAssembly, no server.",
    editUrl: false,
    tableOfContents: false,
    prev: false,
    next: false,
  }}
>
  <p>
    Write <code>--!strict</code> Luau and it is checked against <code>wow-forever.d.luau</code> as you type: errors are
    underlined, hovering a name shows its type, and <kbd>Ctrl</kbd>+<kbd>Space</kbd> completes. Everything runs in your
    browser: Luau's own analysis library, compiled to WebAssembly, in a Web Worker.
  </p>
  <Playground client:only="react" />
  <Aside type="note" title="How close is this to luau-lsp?">
    The checker is Luau's analysis library (via <a href="https://github.com/luau-rs/luau">@luau-rs/luau</a>), the same
    code luau-lsp runs, loading the same definitions file. It checks one module with no <code>require</code>, and it does
    not read <code>.luaurc</code>, so declare your own SavedVariables inline while you experiment. For a real addon, use
    luau-lsp: see <a href={withBase("/start/editor-setup/")}>editor setup</a>.
  </Aside>
</StarlightPage>
