{
  "private": true,
  "name": "wow-forever-luau-types-docs",
  "version": "0.0.0",
  "type": "module",
  "description": "The documentation site for wow-forever-luau-types (Astro + Starlight, static for GitHub Pages).",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26.13.1"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "bun run lint && bun run typecheck:astro",
    "lint": "TSRS_FAST=1 oxlint --type-aware --type-check --deny-warnings",
    "typecheck": "bun run typecheck:ts && bun run typecheck:astro",
    "typecheck:ts": "tsrs --fast -p tsconfig.src.json && tsrs --fast -p tsconfig.test.json && tsrs --fast -p tsconfig.aux.json",
    "typecheck:astro": "astro check --tsconfig tsconfig.src.json",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "test": "bun test",
    "links": "bun scripts/check-links.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@astrojs/starlight": "0.43.1",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@fontsource/cinzel": "5.3.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "luau-web-checker": "https://github.com/Braden1996/luau-web-checker/releases/download/v0.2.0/luau-web-checker-0.2.0.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "6.0.3"
  }
}
