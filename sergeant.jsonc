{
  "$schema": "./.sergeant/schema.json",
  "plugins": [
    "ts",
    "bun",
    "oxlint",
    "astro",
    "luau",
    "lune",
    "woof",
    "wow",
    "actionlint",
    "zizmor",
    "lychee",
    "secrets",
  ],
  "packages": ["packages/libraries/*/*/*", "packages/runtimes/*"],
  "cache": {
    "untrackable": "degrade",
  },
  "boundaries": {
    "noUnitCycles": true,
  },
  "check": {
    "samples": {
      "description": "Type-check addon samples and verify the expected diagnostics",
      "run": [
        "node",
        "packages/runtimes/cli/scripts/check-workspace.effect.mjs",
        "lune",
        "run",
        "packages/runtimes/cli/src/test.effect.luau",
      ],
      "cache": false,
      "inputs": ["packages/runtimes/cli/scripts/check-workspace.effect.mjs"],
      "tools": ["lune"],
    },
    "snapshots": {
      "description": "Compare converter snapshots and load them in luau-lsp",
      "run": [
        "node",
        "packages/runtimes/cli/scripts/check-workspace.effect.mjs",
        "lune",
        "run",
        "packages/runtimes/cli/src/snapshot.effect.luau",
      ],
      "cache": false,
      "inputs": ["packages/runtimes/cli/scripts/check-workspace.effect.mjs"],
      "tools": ["lune"],
    },
    "generator-fresh": {
      "description": "Verify generated artifacts against upstream.toml",
      "run": [
        "node",
        "packages/runtimes/cli/scripts/check-workspace.effect.mjs",
        "lune",
        "run",
        "packages/runtimes/cli/src/main",
        "--",
        "--check",
      ],
      "cache": false,
      "inputs": ["packages/runtimes/cli/scripts/check-workspace.effect.mjs"],
      "tools": ["lune"],
    },
    "coverage-diff": {
      "description": "Reject unapproved typing regressions against COVERAGE_BASE",
      "run": [
        "node",
        "packages/runtimes/cli/scripts/check-workspace.effect.mjs",
        "lune",
        "run",
        "packages/runtimes/cli/src/coverage-diff.effect.luau",
      ],
      "cache": false,
      "passThroughEnv": ["CI", "COVERAGE_BASE", "GITHUB_STEP_SUMMARY"],
      "inputs": ["packages/runtimes/cli/scripts/check-workspace.effect.mjs"],
      "tools": ["lune"],
    },
    "template-build": {
      "description": "Verify the addon template's Lua 5.1 output and TOC",
      "run": [
        "node",
        "packages/runtimes/cli/scripts/check-workspace.effect.mjs",
        "lune",
        "run",
        "packages/runtimes/cli/src/template-build.effect.luau",
      ],
      "cache": false,
      "inputs": ["packages/runtimes/cli/scripts/check-workspace.effect.mjs"],
      "tools": ["lune"],
    },
    "editor-settings": {
      "description": "Verify editor settings against the generated disabled globals",
      "run": [
        "node",
        "packages/runtimes/cli/scripts/check-workspace.effect.mjs",
        "lune",
        "run",
        "packages/runtimes/cli/src/editor-settings.effect.luau",
      ],
      "cache": false,
      "inputs": ["packages/runtimes/cli/scripts/check-workspace.effect.mjs"],
      "tools": ["lune"],
    },
    "luaurc-pin": {
      "description": "Verify the Lune typedefs version in .luaurc",
      "run": [
        "node",
        "packages/runtimes/cli/scripts/check-workspace.effect.mjs",
        "lune",
        "run",
        "packages/runtimes/cli/src/check-luaurc.effect.luau",
      ],
      "cache": false,
      "inputs": ["packages/runtimes/cli/scripts/check-workspace.effect.mjs"],
      "tools": ["lune"],
    },
    "astro-types": {
      "description": "Type-check Astro templates and TypeScript",
      "run": [
        "node",
        "packages/runtimes/cli/scripts/check-workspace.effect.mjs",
        "bun",
        "--cwd",
        "packages/runtimes/docs",
        "run",
        "typecheck",
      ],
      "cache": false,
      "inputs": ["packages/runtimes/cli/scripts/check-workspace.effect.mjs"],
      "tools": ["bun", "node"],
    },
    "template-workflows": {
      "description": "Lint the starter workflow",
      "run": [
        "node",
        "packages/runtimes/cli/scripts/check-workspace.effect.mjs",
        "actionlint",
        "templates/addon/.github/workflows/check.yml",
      ],
      "cache": false,
      "inputs": ["packages/runtimes/cli/scripts/check-workspace.effect.mjs"],
      "tools": ["actionlint"],
    },
    "template-zizmor": {
      "description": "Audit the starter workflow",
      "run": [
        "node",
        "packages/runtimes/cli/scripts/check-workspace.effect.mjs",
        "zizmor",
        "--offline",
        "--min-severity",
        "low",
        "templates/addon/.github",
      ],
      "cache": false,
      "inputs": ["packages/runtimes/cli/scripts/check-workspace.effect.mjs"],
      "tools": ["zizmor"],
    },
  },
  "commands": {
    "generate": {
      "description": "Regenerate definitions, coverage and banner from upstream.toml",
      "run": ["lune", "run", "packages/runtimes/cli/src/main"],
    },
    "editor-settings-write": {
      "description": "Update editor disabled globals",
      "run": ["lune", "run", "packages/runtimes/cli/src/editor-settings.effect.luau", "--", "--write"],
    },
    "upstream-bump": {
      "description": "Move the upstream pins to their branch heads",
      "run": ["lune", "run", "packages/runtimes/cli/src/bump-upstream.effect.luau"],
    },
  },
  "luau": {
    "target": "luau",
    "runtime": "lune",
    "forbidLuauStdlib": false,
    "strictLints": false,
  },
}
