// Renovate: one PR per dependency, weekly, never automerged. Each PR runs the full CI gate.
// - Tools in mise.toml (mise.lock is refreshed with the bump).
// - GitHub Actions, pinned by digest.
// - The two upstream commits in upstream.toml. A bump fails the `fresh` job until someone runs
//   `lune run scripts/generate` and commits the regenerated definitions, so every upstream change is
//   reviewed as a diff of definitions/.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':dependencyDashboard'],
  timezone: 'Etc/UTC',
  schedule: ['before 6am on monday'],
  automerge: false,
  prHourlyLimit: 0,
  prConcurrentLimit: 10,
  separateMajorMinor: true,
  semanticCommits: 'enabled',
  semanticCommitType: 'build',
  semanticCommitScope: 'deps',
  enabledManagers: ['mise', 'github-actions', 'custom.regex'],
  packageRules: [
    {
      matchManagers: ['github-actions'],
      pinDigests: true,
    },
    {
      // Lune and the .luaurc alias to its type definitions move together.
      matchPackageNames: ['lune-org/lune', 'github:lune-org/lune'],
      groupName: 'lune',
    },
    {
      matchFileNames: ['upstream.toml'],
      semanticCommitType: 'feat',
      semanticCommitScope: 'upstream',
      commitMessageTopic: '{{depName}}',
    },
  ],
  customManagers: [
    {
      // upstream.toml: `# renovate: datasource=git-refs depName=<url> currentValue=<branch>` above `commit = "<sha>"`
      customType: 'regex',
      managerFilePatterns: ['/^upstream\\.toml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\s+commit = "(?<currentDigest>[0-9a-f]{40})"',
      ],
    },
    {
      // .luaurc: the lune type definitions alias follows the lune version in mise.toml.
      customType: 'regex',
      managerFilePatterns: ['/^\\.luaurc$/'],
      matchStrings: ['\\.typedefs/(?<currentValue>\\d+\\.\\d+\\.\\d+)/'],
      depNameTemplate: 'lune-org/lune',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v?(?<version>.*)$',
    },
  ],
}
