		["math.modf"] = true,
		["math.pow"] = true,
		["math.rad"] = true,
		["math.random"] = true,
		["math.randomseed"] = true,
		["math.sin"] = true,
		["math.sqrt"] = true,
		["math.tan"] = true,
	},

	-- Local names upstream's compat.lua uses for the standard tables.
	stdlibAliases = { tab = "table", str = "string", math = "math", string = "string", table = "table" },
}
