--!strict
-- Renders definitions/COVERAGE.md from the build's report and per-API coverage.

local Build = require("./build")

local Coverage = {}

-- The coverage categories, in table order, with their headings.
local CATEGORIES: { { key: Build.Category, label: string } } = {
	{ key = "functions", label = "Functions (global and `C_*` namespaces)" },
	{ key = "widgetMethods", label = "Widget and script-object methods" },
	{ key = "events", label = "Events (payload types)" },
	{ key = "structures", label = "Structures and mixins" },
	{ key = "enums", label = "Enums" },
	{ key = "widgets", label = "Widget types" },
}

-- The client lists functions come from, in table order.
local FUNCTION_KINDS: { { key: string, label: string } } = {
	{ key = "C API", label = "C API (the game's native functions)" },
	{ key = "Lua", label = "Lua library and WoW's Lua extensions" },
	{ key = "FrameXML", label = "FrameXML (Blizzard's own UI code)" },
}

local STATUSES: { Build.Status } = { "untyped", "excluded" }

local function sortedKeys<V>(t: { [string]: V }): { string }
	local keys = {}
	for k in t do
		table.insert(keys, k)
	end
	table.sort(keys)
	return keys
end

-- A Markdown table row; `|` inside a cell is escaped.
local function row(cells: { string | number }): string
	local escaped = {}
	for _, cell in cells do
		table.insert(escaped, (string.gsub(tostring(cell), "|", "\\|")))
	end
	return "| " .. table.concat(escaped, " | ") .. " |"
end

local function share(s: Build.StatusCounts): string
	local total = s.typed + s.untyped
	if total == 0 then
		return "n/a"
	end
	return string.format("%.1f%%", s.typed / total * 100)
end

local EMPTY: Build.StatusCounts = { typed = 0, untyped = 0, excluded = 0 }

function Coverage.markdown(report: Build.Report, coverage: Build.Coverage): string
	local lines = {
		"# Coverage",
		"",
		"Generated by `moon run generator:generate`; do not edit. Every API the WoW: Forever client has is listed",
		"in [`coverage.json`](coverage.json) as typed (with its source), untyped, or excluded (with a note).",
		"CI fails if an API that was typed becomes untyped.",
		"",
		"| Category | Typed | Untyped | Excluded | Typed share |",
		"| --- | ---: | ---: | ---: | ---: |",
	}
	for _, c in CATEGORIES do
		local s = report.summary[c.key] or EMPTY
		table.insert(lines, row({ c.label, s.typed, s.untyped, s.excluded, share(s) }))
	end

	table.insert(lines, "")
	table.insert(lines, "## Functions by kind")
	table.insert(lines, "")
	table.insert(lines, "| Kind | Typed | Untyped | Excluded | Typed share |")
	table.insert(lines, "| --- | ---: | ---: | ---: | ---: |")
	for _, kind in FUNCTION_KINDS do
		local s = report.functionsByClientList[kind.key] or EMPTY
		table.insert(lines, row({ kind.label, s.typed, s.untyped, s.excluded, share(s) }))
	end

	-- Where the types come from.
	table.insert(lines, "")
	table.insert(lines, "## Sources of typed APIs")
	table.insert(lines, "")
	table.insert(lines, "| Category | Source | Count |")
	table.insert(lines, "| --- | --- | ---: |")
	for _, c in CATEGORIES do
		local bySource: { [string]: number } = {}
		for _, e in Build.entries(coverage, c.key) do
			if e.status == "typed" then
				local s = e.source or "?"
				bySource[s] = (bySource[s] or 0) + 1
			end
		end
		for _, source in sortedKeys(bySource) do
			table.insert(lines, row({ c.key, source, bySource[source] }))
		end
	end

	-- Why things are untyped or excluded.
	table.insert(lines, "")
	table.insert(lines, "## Untyped and excluded APIs")
	table.insert(lines, "")
	table.insert(lines, "| Category | Status | Note | Count |")
	table.insert(lines, "| --- | --- | --- | ---: |")
	for _, c in CATEGORIES do
		local byStatus: { [Build.Status]: { [string]: number } } = { untyped = {}, excluded = {} }
		for _, e in Build.entries(coverage, c.key) do
			local notes = byStatus[e.status]
			if notes then
				local note = e.note or ""
				notes[note] = (notes[note] or 0) + 1
			end
		end
		for _, status in STATUSES do
			local notes = byStatus[status]
			for _, note in sortedKeys(notes) do
				table.insert(lines, row({ c.key, status, note, notes[note] }))
			end
		end
	end

	-- How the results of functions and widget methods are shaped (api-shapes.json).
	table.insert(lines, "")
	table.insert(lines, "## Result shapes")
	table.insert(lines, "")
	table.insert(
		lines,
		"Every function and widget method has a result shape in [`api-shapes.json`](api-shapes.json), for"
	)
	table.insert(lines, "libraries that wrap the API (`maybe`: one nilable result; `record`: several named results).")
	table.insert(lines, "")
	table.insert(lines, "| Shape | Functions | Widget methods |")
	table.insert(lines, "| --- | ---: | ---: |")
	local functions = report.shapes.functions or {}
	local methods = report.shapes.widgetMethods or {}
	local kinds: { [string]: boolean } = {}
	for kind in functions do
		kinds[kind] = true
	end
	for kind in methods do
		kinds[kind] = true
	end
	for _, kind in sortedKeys(kinds) do
		table.insert(lines, row({ "`" .. kind .. "`", functions[kind] or 0, methods[kind] or 0 }))
	end

	table.insert(lines, "")
	table.insert(
		lines,
		"Calls the documentation says may return nothing at all have every result optional (`T?`), by reason:"
	)
	table.insert(lines, "")
	table.insert(lines, "| Reason | Functions | Widget methods |")
	table.insert(lines, "| --- | ---: | ---: |")
	local absentFunctions = report.absentResults.functions or {}
	local absentMethods = report.absentResults.widgetMethods or {}
	local reasons: { [string]: boolean } = {}
	for reason in absentFunctions do
		reasons[reason] = true
	end
	for reason in absentMethods do
		reasons[reason] = true
	end
	for _, reason in sortedKeys(reasons) do
		table.insert(lines, row({ "`" .. reason .. "`", absentFunctions[reason] or 0, absentMethods[reason] or 0 }))
	end

	local any = report.anyByForm
	table.insert(lines, "")
	table.insert(lines, "## Strictness")
	table.insert(lines, "")
	table.insert(lines, "`any` in the definitions, by form:")
	table.insert(lines, "")
	table.insert(lines, "| Form | Meaning | Count |")
	table.insert(lines, "| --- | --- | ---: |")
	table.insert(lines, row({ "`{ [any]: any }`", "a parameter that takes any table", any.anyTable }))
	table.insert(lines, row({ "`(...any) -> ...any`", "a parameter that takes any function", any.anyFunction }))
	table.insert(lines, row({ "`...any` in a handler", "script handler and event payload arguments", any.handlerArgs }))
	table.insert(lines, row({ "anything else", "should be 0", any.other }))
	table.insert(lines, "")
	table.insert(
		lines,
		string.format(
			"%d documented structures are derived from another (`Base & { ... }`). %d type names used by upstream "
				.. "could not be resolved and are `unknown`; see `report.json`.",
			report.counts.derivedStructures,
			#report.unresolvedTypes
		)
	)
	table.insert(lines, "")
	return table.concat(lines, "\n")
end

return Coverage
