--!strict
-- Renders definitions/COVERAGE.md from the build's report and per-API coverage.

local Coverage = {}

local CATEGORIES: { { key: string, label: string } } = {
	{ key = "functions", label = "Functions (global and `C_*` namespaces)" },
	{ key = "widgetMethods", label = "Widget and script-object methods" },
	{ key = "events", label = "Events (payload types)" },
	{ key = "structures", label = "Structures and mixins" },
	{ key = "enums", label = "Enums" },
	{ key = "widgets", label = "Widget types" },
}

local function percent(typed: number, total: number): string
	if total == 0 then
		return "n/a"
	end
	return string.format("%.1f%%", typed / total * 100)
end

local function sortedKeys<V>(t: { [string]: V }): { string }
	local keys = {}
	for k in t do
		table.insert(keys, k)
	end
	table.sort(keys)
	return keys
end

function Coverage.markdown(report: { [string]: any }, coverage: { [string]: { [string]: any } }): string
	local lines = {
		"# Coverage",
		"",
		"Generated by `lune run scripts/generate`; do not edit. Every API the WoW: Forever client has is listed in",
		"[`coverage.json`](coverage.json) as typed (with its source), untyped, or excluded (with the reason).",
		"CI fails if an API that was typed becomes untyped.",
		"",
		"| Category | Typed | Untyped | Excluded | Typed share |",
		"| --- | ---: | ---: | ---: | ---: |",
	}
	for _, c in CATEGORIES do
		local s: { [string]: number } = report.summary[c.key] or { typed = 0, untyped = 0, excluded = 0 }
		table.insert(
			lines,
			string.format(
				"| %s | %d | %d | %d | %s |",
				c.label,
				s.typed or 0,
				s.untyped or 0,
				s.excluded or 0,
				percent(s.typed or 0, (s.typed or 0) + (s.untyped or 0))
			)
		)
	end

	-- Functions by the client list they come from.
	table.insert(lines, "")
	table.insert(lines, "## Functions by kind")
	table.insert(lines, "")
	table.insert(lines, "| Kind | Typed | Untyped | Excluded | Typed share |")
	table.insert(lines, "| --- | ---: | ---: | ---: | ---: |")
	local kindLabels: { [string]: string } = {
		["C API"] = "C API (the game's native functions)",
		Lua = "Lua library and WoW's Lua extensions",
		FrameXML = "FrameXML (Blizzard's own UI code)",
	}
	for _, kind in { "C API", "Lua", "FrameXML" } do
		local s: { [string]: number } = report.functionsByClientList[kind] or { typed = 0, untyped = 0, excluded = 0 }
		table.insert(
			lines,
			string.format(
				"| %s | %d | %d | %d | %s |",
				kindLabels[kind],
				s.typed or 0,
				s.untyped or 0,
				s.excluded or 0,
				percent(s.typed or 0, (s.typed or 0) + (s.untyped or 0))
			)
		)
	end

	-- Where the types come from.
	table.insert(lines, "")
	table.insert(lines, "## Sources of typed APIs")
	table.insert(lines, "")
	table.insert(lines, "| Category | Source | Count |")
	table.insert(lines, "| --- | --- | ---: |")
	for _, c in CATEGORIES do
		local bySource: { [string]: number } = {}
		for _, e in coverage[c.key] or {} do
			if e.status == "typed" then
				local s = e.source or "?"
				bySource[s] = (bySource[s] or 0) + 1
			end
		end
		for _, source in sortedKeys(bySource) do
			table.insert(lines, string.format("| %s | %s | %d |", c.key, source, bySource[source]))
		end
	end

	-- Why things are excluded or untyped.
	table.insert(lines, "")
	table.insert(lines, "## Reasons")
	table.insert(lines, "")
	table.insert(lines, "| Category | Status | Reason | Count |")
	table.insert(lines, "| --- | --- | --- | ---: |")
	for _, c in CATEGORIES do
		local byReason: { [string]: number } = {}
		for _, e in coverage[c.key] or {} do
			if e.status ~= "typed" then
				local key = e.status .. "\0" .. (e.reason or "")
				byReason[key] = (byReason[key] or 0) + 1
			end
		end
		for _, key in sortedKeys(byReason) do
			local status, reason = string.match(key, "^(.-)%z(.*)$")
			table.insert(
				lines,
				string.format("| %s | %s | %s | %d |", c.key, status :: string, reason :: string, byReason[key])
			)
		end
	end

	table.insert(lines, "")
	table.insert(lines, "## Strictness")
	table.insert(lines, "")
	table.insert(
		lines,
		string.format(
			"`any` appears %d times in the definitions, only in the documented exceptions: `{ [any]: any }` for a"
				.. " parameter that takes any table, `(...any) -> ...any` for one that takes any function, and the"
				.. " arguments of script handlers and `OnEvent` payloads, which vary by script and event.",
			report.counts.anyOccurrences
		)
	)
	table.insert(
		lines,
		string.format(
			"%d documented structures are derived from another (`Base & { ... }`).",
			report.counts.derivedStructures
		)
	)
	table.insert(
		lines,
		string.format(
			"%d type names used by upstream could not be resolved and are `unknown`; see `report.json`.",
			#report.unresolvedTypes
		)
	)
	table.insert(lines, "")
	return table.concat(lines, "\n")
end

return Coverage
