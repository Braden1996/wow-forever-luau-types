{
  "luau-lsp.platform.type": "standard",
  "luau-lsp.sourcemap.enabled": false,
  "luau-lsp.fflags.enableNewSolver": true,
  "luau-lsp.fflags.enableByDefault": true,
  "luau-lsp.fflags.sync": false,
  "luau-lsp.types.definitionFiles": {
    "@wow": "definitions/wow-forever.d.luau",
    "@sample": "tests/pass/sample-addon/addon.d.luau",
    "@template": "templates/addon/types/addon.d.luau"
  },
  "luau-lsp.types.disabledGlobals": [
    "bit32",
    "buffer",
    "coroutine.close",
    "coroutine.isyieldable",
    "debug",
    "math.e",
    "math.map",
    "math.nan",
    "math.noise",
    "math.phi",
    "math.randomseed",
    "math.sqrt2",
    "math.tau",
    "os",
    "rawlen",
    "require",
    "string.pack",
    "string.packsize",
    "string.unpack",
    "table.clear",
    "table.clone",
    "table.find",
    "table.move",
    "table.pack",
    "table.unpack",
    "typeof",
    "utf8",
    "vector"
  ],
  "luau-lsp.ignoreGlobs": [".upstream/**", "definitions/**", "tests/snapshots/**", "tests/fail/**"],
  "search.exclude": {
    ".upstream": true,
    "definitions/wow-forever.d.luau": true,
    "mise.lock": true
  },
  "editor.rulers": [120],
  "[luau]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false
  },
  "json.schemas": [
    {
      "fileMatch": ["/sergeant.jsonc", "/sergeant.json"],
      "url": "./.sergeant/schema.json"
    },
    {
      "fileMatch": ["/**/sergeant.jsonc", "/**/sergeant.json", "!/sergeant.jsonc", "!/sergeant.json"],
      "url": "./.sergeant/schema.unit.json"
    },
    {
      "fileMatch": ["/sergeant.allow.jsonc", "/sergeant.allow.json"],
      "url": "./.sergeant/schema.allow.json"
    }
  ]
}
