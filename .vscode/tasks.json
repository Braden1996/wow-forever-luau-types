{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "check (the CI gate)",
      "type": "shell",
      "command": "mise exec -- moon run :check",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "generate definitions",
      "type": "shell",
      "command": "mise exec -- moon run generator:generate",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "test samples and template",
      "type": "shell",
      "command": "mise exec -- moon run tests:samples",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "update negative-fixture expectations",
      "type": "shell",
      "command": "mise exec -- lune run scripts/test -- --update",
      "problemMatcher": []
    },
    {
      "label": "format everything",
      "type": "shell",
      "command": "mise exec -- moon run repo:fmt generator:fmt tests:fmt",
      "problemMatcher": []
    }
  ]
}
